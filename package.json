{
  "name": "siyuan-contacts",
  "version": "0.7.11",
  "type": "module",
  "description": "小驴人脉 (Lv Contacts)：在思源笔记里管理人脉与人际关系——一人一文档，数据库主干，关系图谱与农历生日提醒",
  "repository": "https://github.com/xiaolv-suite/siyuan-contacts",
  "homepage": "https://github.com/xiaolv-suite/siyuan-contacts",
  "author": "xiaolv-suite",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:ecosystem:reliability": "node --test tests/ecosystem-reliability.test.cjs",
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "run-s clean build:app build:checksum",
    "build:app": "cross-env NODE_ENV=production vite build",
    "build:checksum": "node scripts/package-checksum.mjs",
    "check": "run-s check:types check:svelte",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "node scripts/clean.js",
    "make-link": "node scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "check:release": "node scripts/check-release.mjs",
    "audit:tokens": "node scripts/audit-design-tokens.mjs",
    "test:ui": "node scripts/e2e/ui-smoke.mjs",
    "test:ui:mobile": "cross-env LVCT_UI_MOBILE=1 node scripts/e2e/ui-smoke.mjs",
    "test:ui:host": "cross-env LVCT_UI_HOST=1 node scripts/e2e/ui-smoke.mjs",
    "e2e:isolated": "node scripts/e2e/e2e-isolated.mjs",
    "preview:isolated": "cross-env TEST_ISOLATED_PORT=43920 node scripts/e2e/e2e-isolated.mjs --stage2-only --keep",
    "seed:isolated": "node scripts/e2e/seed-isolated-preview.mjs",
    "test:e2e:parallel": "node scripts/e2e/parallel-runner.mjs --config scripts/e2e/parallel.example.json",
    "spike": "node scripts/spike/av-spike.mjs",
    "spike:init": "node scripts/spike/init-resume-spike.mjs",
    "spike:b13": "node scripts/spike/b13-org-spike.mjs",
    "spike:b14": "node scripts/spike/b14-graph-spike.mjs",
    "spike:task": "node scripts/spike/task-item-spike.mjs",
    "spike:scale": "node --expose-gc scripts/spike/scale-baseline-spike.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/cytoscape": "^3.31.0",
    "@types/livereload": "^0.9.5",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "livereload": "^0.10.3",
    "npm-run-all": "^4.1.5",
    "sass": "^1.106.1",
    "siyuan": "1.2.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "cytoscape": "^3.34.4"
  }
}
